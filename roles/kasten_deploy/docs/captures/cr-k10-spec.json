{
  "apiVersion": "apik10.kasten.io/v1alpha1",
  "kind": "K10",
  "metadata": {
    "name": "k10",
    "namespace": "kasten-io"
  },
  "spec": {
    "auth": {
      "basicAuth": {
        "enabled": false,
        "htpasswd": "",
        "secretName": ""
      },
      "tokenAuth": {
        "enabled": true
      }
    },
    "global": {
      "persistence": {
        "catalog": {
          "size": ""
        },
        "storageClass": ""
      }
    },
    "limiter": {
      "catalogReplicas": "1",
      "controllermanagerReplicas": "1",
      "cryptoReplicas": "1"
    },
    "metering": {
      "mode": "airgap"
    },
    "route": {
      "enabled": true,
      "host": "",
      "tls": {
        "enabled": true
      }
    }
  }
}
